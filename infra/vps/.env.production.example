TURN_UDP_PORT=3478
TURN_RELAY_PORT_START=60000
TURN_RELAY_PORT_END=60999
LIVEKIT_API_KEY=replace-this-key
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
POCKETBASE_INTERNAL_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
SESSION_ENCRYPTION_SECRET=replace-with-a-43-character-base64url-secret
MANAGEMENT_PASSWORD_HASH=
MANAGEMENT_SESSION_SECRET=replace-with-a-different-43-character-secret
MANAGEMENT_INTERNAL_SECRET=replace-with-a-long-management-internal-secret
