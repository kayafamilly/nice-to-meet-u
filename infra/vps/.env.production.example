POCKETBASE_INTERNAL_URL=http://127.0.0.1:8090
LIVEKIT_HTTP_URL=http://127.0.0.1:7880
LIVEKIT_WEBHOOK_URL=http://127.0.0.1:3000/api/livekit/webhook
POCKETBASE_PORT=8090
REDIS_PORT=6380
LIVEKIT_HTTP_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT_START=50000
LIVEKIT_UDP_PORT_END=54999
