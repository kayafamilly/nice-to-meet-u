[Unit]
Description=Renew the NiceToMeetU TLS certificate
After=network-online.target nginx.service
Wants=network-online.target
ConditionPathExists=/etc/letsencrypt/renewal/nice-to-meet-u.com.conf

[Service]
Type=oneshot
ExecStart=/usr/bin/certbot renew --cert-name nice-to-meet-u.com --quiet --no-random-sleep-on-renew
ExecStartPost=/usr/sbin/nginx -t
ExecStartPost=/bin/systemctl reload nginx

