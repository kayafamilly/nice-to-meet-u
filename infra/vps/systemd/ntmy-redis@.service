[Unit]
Description=NiceToMeetU Redis (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ntmy
Group=ntmy
EnvironmentFile=/etc/nicetomeetu/%i.env
ExecStart=/usr/bin/redis-server --bind 127.0.0.1 --port ${REDIS_PORT} --protected-mode yes --save "" --appendonly no
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
