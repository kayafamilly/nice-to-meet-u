[Unit]
Description=NiceToMeetU LiveKit lifecycle worker (%i)
After=network-online.target ntmy-web@%i.service ntmy-livekit@%i.service
Wants=network-online.target

[Service]
Type=simple
User=ntmy
Group=ntmy
WorkingDirectory=/opt/nicetomeetu
EnvironmentFile=/etc/nicetomeetu/%i.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/nicetomeetu/scripts/livekit-lifecycle-worker.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
