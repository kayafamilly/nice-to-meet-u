# Kept only in the deployment secret store; never commit a populated .env file.
POCKETBASE_INTERNAL_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# Preferred production transport: Brevo transactional API (server-only).
BREVO_API_KEY=replace-with-brevo-api-key

# Optional SMTP fallback. Leave SMTP_HOST empty when BREVO_API_KEY is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_AUTH_METHOD=LOGIN
MAIL_SENDER_ADDRESS=noreply@nice-to-meet-u.com
MAIL_SENDER_NAME=NiceToMeetU
