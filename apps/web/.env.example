# Browser-visible URLs only
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_LIVEKIT_WS_URL=ws://127.0.0.1:7880

# Server-only values
# Paste only the content value from Google's HTML meta-tag verification method.
GOOGLE_SITE_VERIFICATION=
POCKETBASE_INTERNAL_URL=http://127.0.0.1:8090
LIVEKIT_HTTP_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
# Must match infra/local/livekit.native.yaml. Change both files together if needed.
LIVEKIT_API_SECRET=local-dev-livekit-secret-0123456789abcdef
POCKETBASE_INTERNAL_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Used only by the local notification worker and its Next.js internal endpoint.
NOTIFICATION_WORKER_SECRET=replace-with-a-different-long-random-secret
# Used only by the LiveKit lifecycle worker that enforces hard room deadlines.
LIVEKIT_LIFECYCLE_WORKER_SECRET=replace-with-another-long-random-secret
# Generate with: pnpm --filter @ntmy/web exec web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=replace-with-your-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-your-vapid-private-key
# Generate a base64url-encoded 32-byte key; it must be exactly 43 characters.
SESSION_ENCRYPTION_SECRET=replace-with-a-43-character-base64url-secret
